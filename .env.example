# Copy this file to .env and fill in real values. .env is never committed.

# MySQL connection: mysql+pymysql://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=mysql+pymysql://dan:CHANGE_ME@localhost/quiz

# Long random string used to sign logins. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Optional: folder for uploaded images/files and site css/js.
# Defaults to the "static" folder next to config.py.
# STATIC_DIR=/home/dan/proj/qgen/static

# Optional: Anthropic API key for the "Fill in for me" helper.
# Leave unset to hide the helper.
# ANTHROPIC_API_KEY=
